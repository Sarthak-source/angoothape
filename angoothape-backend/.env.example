PORT=8080
NODE_ENV=development
DATABASE_URL=postgres://angoothape:angoothape@localhost:5432/angoothape
JWT_SECRET=change-me-in-production-use-a-long-random-string
JWT_EXPIRES=12h
COOKIE_NAME=ap_token
CORS_ORIGIN=http://localhost:8080,http://localhost:5000,http://localhost:3000
# Set 1 only on local/dev so the login response includes the OTP for the Flutter demo hint.
DEV_RETURN_OTP=1
# Optional SMTP. If unset, OTP is logged to the API console.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# MAIL_FROM=angoothaPe <noreply@example.com>
