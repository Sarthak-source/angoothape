{
  "info": {
    "name": "angoothaPe — Backend API",
    "_postman_id": "angoothape-backend-api-v1",
    "description": "REST API for angoothaPe retailer backend.\n\n**Setup**\n1. Set `baseUrl` (default `http://localhost:8080`)\n2. Seed: `npm run seed` (demo `AP100245` / `Demo@123`)\n3. Run **Login** then **Verify OTP**. With `DEV_RETURN_OTP=1`, OTP and `authToken` are saved automatically.\n\n**Auth:** `Authorization: Bearer {{authToken}}` (cookie `ap_token` also works).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8080"
    },
    {
      "key": "partnerId",
      "value": "AP100245"
    },
    {
      "key": "password",
      "value": "Demo@123"
    },
    {
      "key": "otp",
      "value": ""
    },
    {
      "key": "authToken",
      "value": ""
    },
    {
      "key": "challengeId",
      "value": ""
    },
    {
      "key": "ekycId",
      "value": ""
    },
    {
      "key": "applicationId",
      "value": ""
    },
    {
      "key": "txRef",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "0. Health",
      "description": "Process liveness. No auth.",
      "item": [
        {
          "name": "Health",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/health",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "health"
              ]
            }
          }
        }
      ]
    },
    {
      "name": "1. Auth",
      "description": "Partner login + OTP. Demo seed: AP100245 / Demo@123.\nSet DEV_RETURN_OTP=1 so Login and Forgot return `otp` for Postman to capture.",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/login",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "login"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partnerId\": \"{{partnerId}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.challengeId) pm.collectionVariables.set('challengeId', String(j.challengeId));",
                  "if (j.otp) pm.collectionVariables.set('otp', j.otp);"
                ]
              }
            }
          ]
        },
        {
          "name": "Verify OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/otp",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "otp"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partnerId\": \"{{partnerId}}\",\n  \"otp\": \"{{otp}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.token) pm.collectionVariables.set('authToken', j.token);"
                ]
              }
            }
          ]
        },
        {
          "name": "Resend OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/resend",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "resend"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partnerId\": \"{{partnerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.otp) pm.collectionVariables.set('otp', j.otp);"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot password",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/forgot",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partnerId\": \"{{partnerId}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "if (j.otp) pm.collectionVariables.set('otp', j.otp);"
                ]
              }
            }
          ]
        },
        {
          "name": "Forgot confirm",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/forgot/confirm",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "forgot",
                "confirm"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"partnerId\": \"{{partnerId}}\",\n  \"otp\": \"{{otp}}\",\n  \"password\": \"{{password}}\"\n}"
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/auth/logout",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "auth",
                "logout"
              ]
            }
          }
        }
      ]
    },
