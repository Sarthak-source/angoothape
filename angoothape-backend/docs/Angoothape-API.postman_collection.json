            "url": {
              "raw": "{{baseUrl}}/api/transactions?q=&status=all&svc=all&range=30",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "api",
                "transactions"
              ],
              "query": [
                {
                  "key": "q",
                  "value": ""
                },
                {
                  "key": "status",
                  "value": "all"
                },
                {
                  "key": "svc",
                  "value": "all"
                },
                {
                  "key": "range",
                  "value": "30"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const j = pm.response.json();",
                  "const first = Array.isArray(j.tx) ? j.tx[0] : null;",
                  "if (first?.ref) pm.collectionVariables.set('txRef', first.ref);"
                ]
              }
            }
          ]
        },
        {
          "name": "Get transaction",
          "request": {
            "method": "GET",
            "header": [
